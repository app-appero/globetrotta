rules_version = '2';

// Il sito legge content e projects direttamente da Firestore. Gli altri
// documenti restano privati; le scritture sono sempre riservate all'admin.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'trottarosario@gmail.com';
    }

    match /content/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{document} {
      allow read: if isAdmin() || resource.data.status != 'draft';
      allow write: if isAdmin();
    }

    match /contactRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'email', 'company', 'need', 'description', 'privacyAccepted', 'createdAt', 'status'
      ])
      && request.resource.data.privacyAccepted == true
      && request.resource.data.status == 'new'
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.need is string
      && request.resource.data.description is string;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
