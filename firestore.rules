rules_version = '2';

// Nessun accesso pubblico: il sito pubblico legge i contenuti da src/data/*.js
// (generati da scripts/sync-content.mjs), mai da Firestore a runtime.
// Firestore è usato solo dal pannello /admin (autenticato) e dallo script di
// sync, che usa firebase-admin con una service account e bypassa queste regole.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'trottarosario@gmail.com';
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
