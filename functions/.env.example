# I valori effettivi sono in functions/.env.
# Non copiare qui la password: si registra a parte, una volta sola,
# con firebase functions:secrets:set SMTP_PASS
# e poi si pubblica con npm run deploy:notifications.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=trottarosario@gmail.com
SMTP_FROM=trottarosario@gmail.com
NOTIFY_TO=trottarosario@gmail.com
SITE_URL=https://globetrotta.com
