# I valori effettivi sono in functions/.env.
# Non copiare qui la password della casella Aruba: si registra a parte, una volta sola,
# con firebase functions:secrets:set SMTP_PASS
# e poi si pubblica con npm run deploy:notifications.

SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@globetrotta.it
SMTP_FROM=info@globetrotta.it
NOTIFY_TO=info@globetrotta.it
SITE_URL=https://globetrotta.com
