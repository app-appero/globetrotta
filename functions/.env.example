# Copia questo file in functions/.env.globetrotta (non va committato).
# Poi pubblica solo la funzione: firebase deploy --only functions
# Serve il piano Blaze: le Cloud Functions non sono disponibili sul piano Spark.
#
# Con Gmail usa una password per le app, non la password dell'account:
# https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO=trottarosario@gmail.com
SITE_URL=https://globetrotta.com
