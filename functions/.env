# Valori non segreti della notifica email. Vengono pubblicati con la Cloud Function.
# La password non sta in questo file: prima del deploy va registrata con
# firebase functions:secrets:set SMTP_PASS
# (password per le app di Gmail, non la password dell'account).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=trottarosario@gmail.com
SMTP_FROM=trottarosario@gmail.com
NOTIFY_TO=trottarosario@gmail.com
SITE_URL=https://globetrotta.com
