# Valori non segreti della notifica email. Vengono pubblicati con la Cloud Function.
# La posta esce da Aruba come info@globetrotta.it.
# La password della casella non sta in questo file: prima del deploy va registrata con
# firebase functions:secrets:set SMTP_PASS

SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@globetrotta.it
SMTP_FROM=info@globetrotta.it
NOTIFY_TO=info@globetrotta.it
SITE_URL=https://globetrotta.com
