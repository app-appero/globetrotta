# Configurazione Firebase per il pannello admin (/admin).
# Copia questo file in .env.local (già in .gitignore) e compila con i valori
# della tua Web App Firebase (Project Settings > General > Your apps > Web app).
# Questi valori non sono segreti (finiscono comunque nel bundle del browser):
# la sicurezza reale è affidata alle Firestore/Storage security rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Metti a "true" per collegare il pannello /admin al Firebase Local Emulator
# Suite (npm run emulators) invece che al progetto Firebase reale. In questo
# caso basta valorizzare VITE_FIREBASE_PROJECT_ID (es. demo-globetrotta,
# anche senza un progetto Firebase reale) e le altre chiavi sopra non servono.
# Vedi README, sezione "Testare in locale con gli emulatori Firebase".
VITE_USE_FIREBASE_EMULATORS=false
