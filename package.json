{
  "name": "globetrotta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build",
    "preview": "vite preview",
    "postbuild": "node scripts/generate-sitemap.js",
    "seed-content": "node scripts/seed-content.mjs",
    "sync-content": "node scripts/sync-content.mjs",
    "publish": "npm run sync-content && npm run build && firebase deploy",
    "emulators": "firebase emulators:start --project demo-globetrotta --import=./.emulator-data --export-on-exit",
    "emulators:seed": "firebase emulators:exec --project demo-globetrotta --export-on-exit=./.emulator-data \"npm run seed-content\""
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^1.3.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^8.2.2",
    "vite-react-ssg": "^0.9.2"
  }
}
